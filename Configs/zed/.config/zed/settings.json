// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "sidebar_side": "right"
  },
  "agent_buffer_font_size": 18.0,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "autoscroll_on_clicks": true,
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMonoNF Nerd Font",
  "buffer_font_size": 20.0,
  "cli_default_open_behavior": "new_window",
  "code_lens": "on",
  "colorize_brackets": true,
  "context_servers": {
    "chrome-devtools-mcp-zed": {
      "enabled": true,
      "remote": false,
      "settings": {
        "accept_insecure_certs": null,
        "auto_connect": null,
        "browser_url": null,
        "category_emulation": null,
        "category_network": null,
        "category_performance": null,
        "channel": "stable",
        "chrome_arg": [],
        "executable_path": "/usr/bin/thorium-browser-avx2",
        "extra_args": ["--no-usage-statistics"],
        "headless": false,
        "isolated": null,
        "log_file": null,
        "proxy_server": null,
        "user_data_dir": null,
        "viewport": null,
        "ws_endpoint": null,
        "ws_headers": null
      }
    },
    "mcp-server-exa-search": {
      "enabled": true,
      "remote": false,
      "settings": {
        "exa_api_key": null,
        "tools": null
      }
    }
  },
  "cursor_animation": { "enabled": true },
  "cursor_blink": true,
  "cursor_shape": "block",
  "debugger": { "button": false },
  "diagnostics": { "inline": { "enabled": true } },
  "disable_ai": true,
  "ensure_final_newline_on_save": true,
  "file_types": {
    "Shell Script": ["*.inc", "*.sh", "*.bash", "*.zsh"]
  },
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": true,
      "location": "status_bar",
      "show_commit_summary": true
    }
  },
  "git_panel": { "fallback_branch_name": "main" },
  "gutter": {
    "min_line_number_digits": 3,
    "line_numbers": true,
    "runnables": true,
    "folds": true
  },
  "helix_mode": true,
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true,
    "show_other_hints": true,
    "show_type_hints": false,
    "show_value_hints": true
  },
  "inline_code_actions": true,
  "languages": {
    "Shell Script": {
      "formatter": {
        "external": { "command": "shellfmt" }
      },
      "document_folding_ranges": "on",
      "code_actions_on_format": {
        "source.fixAll.shellcheck": true
      }
    },
    "C": {
      "formatter": {
        "external": { "command": "astyle" }
      }
    },
    "C++": {
      "formatter": {
        "external": { "command": "astyle" }
      }
    },
    "Java": {
      "formatter": {
        "external": { "command": "astyle" }
      }
    },
    "Fish": {
      "formatter": {
        "external": { "command": "fish_indent" }
      }
    },
    "HTML": {
      "prettier": { "allowed": true },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "CSS": {
      "prettier": { "allowed": false },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "JSON": {
      "prettier": { "allowed": false },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "JSONC": {
      "prettier": { "allowed": false },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "JavaScript": {
      "prettier": { "allowed": false },
      "format_on_save": "on",
      "language_servers": [
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!deno",
        "!eslint",
        "..."
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "TypeScript": {
      "prettier": { "allowed": false },
      "format_on_save": "on",
      "language_servers": [
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!deno",
        "!eslint",
        "..."
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "TSX": {
      "prettier": { "allowed": false },
      "format_on_save": "on",
      "language_servers": [
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
        "!deno",
        "!eslint",
        "..."
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "PHP": {
      "language_servers": [
        "phptools",
        "!phpantom",
        "!intelephense",
        "!phpactor",
        "..."
      ]
    },
    "Vue.js": {
      "prettier": { "allowed": true },
      "format_on_save": "on"
      // ,"formatter": {
      //   "external": {
      //     "command": "prettier",
      //     "arguments": [
      //       "--ignore-path=/dev/null",
      //       "--ignore-unknown=false",
      //       "--config=/home/othman/.config/.prettierrc.json",
      //       "--stdin-filepath",
      //       "{buffer_path}"
      //     ]
      //   }
      // }
    },
    "Markdown": {
      "prettier": { "allowed": false },
      "format_on_save": "on",
      "extend_list_on_newline": true,
      "indent_list_on_tab": true,
      "remove_trailing_whitespace_on_save": true,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--ignore-path=/dev/null",
            "--ignore-unknown=false",
            "--config=/home/othman/.config/.prettierrc.json",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "SQL": {
      "prettier": { "allowed": false },
      "formatter": "language_server"
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": "language_server",
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": false,
        "show_other_hints": true
      }
    },
    "TOML": {
      "formatter": {
        "external": { "command": "taplo", "arguments": ["fmt", "-"] }
      }
    },
    "XML": {
      "formatter": {
        "external": { "command": "xmllint", "arguments": ["--format", "-"] }
      }
    },
    "Python": {
      "language_servers": ["basedpyright", "!ruff-lsp"],
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    },
    "Rust": {
      "formatter": {
        "external": {
          "command": "rustfmt",
          "arguments": ["--config-path", "/home/othman/.config/rustfmt.toml"]
        }
      }
    }
  },
  "line_ending": "enforce_lf",
  "lsp": {
    "arduino-language-server": {
      "binary": {
        "path": "/usr/bin/arduino-language-server",
        "arguments": [
          "-clangd",
          "/usr/bin/clangd",
          "-cli",
          "/usr/bin/arduino-cli",
          "-cli-config",
          "/home/othman/.arduino15/arduino-cli.yaml",
          "-fqbn",
          "arduino:avr:uno"
        ]
      }
    },
    "bash-language-server": {
      "settings": {
        "bashIde": {
          "backgroundAnalysisMaxFiles": 500,
          "enableSourceErrorDiagnostics": true,
          "explainshellEndpoint": "",
          "includeAllWorkspaceSymbols": false,
          "shellcheckPath": "/usr/bin/shellcheck",
          "shellcheckExternalSources": true,
          "shfmt": {
            "path": "/usr/bin/shfmt",
            "binaryNextLine": true,
            "caseIndent": false,
            "funcNextLine": false,
            "ignoreEditorconfig": false,
            "languageDialect": "auto",
            "simplifyCode": true,
            "spaceRedirects": false
          }
        }
      }
    },
    "biome": {
      "enable_lsp_tasks": true,
      "settings": {
        "require_config_file": true
      }
    },
    "json-language-server": {
      "initialization_options": {
        "provideFormatter": false
      },
      "settings": {
        "json": {
          "validate": { "enable": true },
          "format": { "enable": false },
          "schemas": [
            {
              "fileMatch": ["deno.json", "deno.jsonc"],
              "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json"
            },
            {
              "fileMatch": ["package.json"],
              "url": "https://www.schemastore.org/package"
            },
            {
              "fileMatch": [".prettierrc.json"],
              "url": "https://json.schemastore.org/prettierrc"
            },
            {
              "fileMatch": ["tsconfig.json", "tsconfig.*.json"],
              "url": "https://json.schemastore.org/tsconfig.json"
            },
            {
              "fileMatch": [".luarc.json", "*.luarc.json"],
              "url": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json"
            }
          ]
        },
        "jsonc": {
          "validate": { "enable": true },
          "format": { "enable": false }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": ["class", "ui", "className"],
        "emmetCompletions": true,
        "includeLanguages": {
          "php": "html",
          "blade": "html",
          "vue": "html"
        },
        "experimental": {
          "classRegex": [
            "(?:'|\"|`)([^']*)(?:'|\"|`)",
            "@class\\(\\[([^\\]]*)\\]\\)",
            "class='([^']*)'",
            "class=\"([^\"]*)\"",
            "class=\\\"([^\\\"]*)\\\"",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "ui:\\s*{([^)]*)\\s*}"
          ]
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
        "checkOnSave": true
      }
    },
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": { "typeCheckingMode": "standard" }
        }
      }
    },
    "syntaqlite-lsp": {
      "binary": {
        "path": "syntaqlite",
        "ignore_system_version": false
      }
    },
    "intelephense": {
      "settings": {
        "intelephense": {
          "codeLens": {
            "implementations": { "enable": true },
            "overrides": { "enable": true },
            "parent": { "enable": true },
            "references": { "enable": true },
            "usages": { "enable": true }
          },
          "completion": { "fullyQualifyGlobalConstantsAndFunctions": true },
          "diagnostics": { "argumentCount": false },
          "maxMemory": 512,
          "phpdoc": { "useFullyQualifiedNames": true },
          "references": { "exclude": [] },
          "rename": { "namespaceMode": "all" },
          "trace": { "server": "messages" }
        }
      }
    },
    "phptools": {
      "initialization_options": {
        "php.completion.autoimport-docblock": "auto-import",
        "php.completion.showParameters": true,
        "php.docblock.colorMode": "simple",
        "php.format.codeStyle": "K&R",
        "php.format.rules.addCommaAfterLastArrayElement": true,
        "php.format.rules.addCommaAfterLastCallParameter": false,
        "php.format.rules.addCommaAfterLastDeclParameter": true,
        "php.format.rules.alignConsecutiveAssignments": false,
        "php.format.rules.alignConstants": true,
        "php.format.rules.alignEnumCases": true,
        "php.format.rules.alignMatchArmBodies": true,
        "php.format.rules.arrayInitializersAlignKeyValuePairs": true,
        "php.format.rules.arrayInitializersNewLineAfterLastElement": true,
        "php.format.rules.arrayInitializersNewLineBeforeFirstElement": true,
        "php.format.rules.arrayInitializersWrap": "onEveryItem",
        "php.format.rules.blankLinesAfterClass": 1,
        "php.format.rules.booleanConstantCasing": "lowercase",
        "php.format.rules.callParametersNewLineAfterLeftParen": true,
        "php.format.rules.callParametersNewLineBeforeRightParen": true,
        "php.format.rules.callParametersWrap": "onEveryItem",
        "php.format.rules.catchOnNewLine": false,
        "php.format.rules.declParametersNewLineAfterLeftParen": true,
        "php.format.rules.declParametersNewLineBeforeRightParen": true,
        "php.format.rules.elseOnNewLine": false,
        "php.format.rules.endWithNewLine": true,
        "php.format.rules.finallyOnNewLine": false,
        "php.format.rules.forStatementNewLineAfterLeftParen": true,
        "php.format.rules.groupUseNewLineBeforeFirstDeclaration": true,
        "php.format.rules.ifStatementNewLineAfterLeftParen": true,
        "php.format.rules.ifStatementNewLineBeforeRightParen": true,
        "php.format.rules.indentBraces": false,
        "php.format.rules.keepControlStatementsOnOneLine": true,
        "php.format.rules.keepFunctionsOnOneLine": true,
        "php.format.rules.newLineAfterImplements": true,
        "php.format.rules.nullConstantCasing": "lowercase",
        "php.format.rules.openBraceOnNewLineForAnonymousClasses": true,
        "php.format.rules.openBraceOnNewLineForBlocks": false,
        "php.format.rules.openBraceOnNewLineForFunctions": false,
        "php.format.rules.openBraceOnNewLineForLambdas": false,
        "php.format.rules.openBraceOnNewLineForNamespaces": false,
        "php.format.rules.openBraceOnNewLineForTypes": false,
        "php.format.rules.spaceAfterCast": true,
        "php.format.rules.spaceAroundConcatenation": true,
        "php.format.rules.spaceBeforeColonInControlStatements": false,
        "php.format.rules.spaceBeforeParenthesesInControlStatements": true,
        "php.format.rules.spaceWithinArrayInitilizersParens": false,
        "php.format.rules.switchStatementNewLineAfterLeftParen": true,
        "php.format.rules.switchStatementNewLineBeforeRightParen": true,
        "php.format.rules.whileStatementNewLineAfterLeftParen": true,
        "php.format.rules.whileStatementNewLineBeforeRightParen": true,
        "php.hover.parametersFullName": true,
        "php.inlayHints.insertOnDoubleClick": true,
        "php.inlayHints.parameters.enabled": false,
        "php.inlayHints.parameters.suppressNameMatchingValue": true,
        "php.inlayHints.types.return": "named",
        "php.problems.excludeGitIgnore": true,
        "php.suggest.basic": false,
        "php.validate.enable": false,
        "php.version": "8.5"
      }
    }
  },
  "minimap": {
    "max_width_columns": 250,
    "show": "never"
  },
  "mouse_wheel_zoom": true,
  "node": {
    "npm_path": "pnpm"
  },
  "on_last_window_closed": "quit_app",
  "preferred_line_length": 120,
  "prettier": {
    "allowed": true
  },
  "project_panel": {
    "auto_reveal_entries": false,
    "dock": "left"
  },
  "proxy": "",
  "relative_line_numbers": "enabled",
  "reveal_if_open": true,
  "search": {
    "include_ignored": false
  },
  "semantic_tokens": "combined",
  "session": {
    "trust_all_worktrees": true
  },
  "soft_wrap": "none",
  "status_bar": {
    "show_active_file": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "terminal": {
    "blinking": "on",
    "copy_on_select": true,
    "font_size": 17.0,
    "line_height": {
      "custom": 1.5
    }
  },
  "theme": "GitHub Dark",
  "title_bar": {
    "show_branch_status_icon": true
  },
  "toolbar": {
    "breadcrumbs": false,
    "code_actions": true
  },
  "ui_font_family": "Inter Variable",
  "ui_font_size": 16.0,
  "use_on_type_format": false,
  "use_smartcase_search": true,
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "vim": {
    "cursor_shape": {
      "normal": "block",
      "insert": "bar",
      "visual": "underline",
      "replace": "underline"
    },
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "never"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "which_key": {
    "enabled": true
  },
  "window_title_format": "${projectName}${separator}${fileName}",
  "window_title_separator": " — "
}
