// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "default_model": {
      "effort": "max",
      "enable_thinking": true,
      "model": "stealth/space-bunny-alpha",
      "provider": "openrouter"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "thinking_display": "always_expanded",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "mcp:mcp-server-exa-search:web_fetch_exa": {
          "default": "allow"
        },
        "mcp:mcp-server-exa-search:web_search_exa": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    }
  },
  "agent_buffer_font_size": 18.0,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "autoscroll_on_clicks": true,
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMonoNF Nerd Font",
  "buffer_font_size": 20.0,
  "cli_default_open_behavior": "new_window",
  "code_lens": "on",
  "colorize_brackets": true,
  "context_servers": {
    "mcp-server-exa-search": {
      "enabled": true,
      "remote": false,
      "settings": {
        "exa_api_key": null,
        "tools": null
      }
    }
  },
  "cursor_animation": {
    "enabled": true
  },
  "cursor_blink": true,
  "cursor_shape": "block",
  "debugger": {
    "button": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "diff_view_style": "split",
  "disable_ai": false,
  "ensure_final_newline_on_save": true,
  "file_types": {
    "Shell Script": [
      "APKBUILD",
      "*.ash",
      "*.bash",
      ".bash_aliases",
      "bash_completion",
      "bash-completion/completions/*",
      "bash_completion.d/*",
      ".bash_history",
      ".bash_login",
      ".bash_logout",
      ".bash_profile",
      ".bashrc",
      "*.bashrc_Apple_Terminal",
      "*.bazelrc",
      "bin/activate",
      "*.cshrc",
      "*.dash",
      "direnvrc",
      "*.ebuild",
      "*.eclass",
      ".hushlogin",
      "i3/config",
      "*.ksh",
      "*.mksh",
      ".profile",
      "*.Renviron",
      ".Renviron",
      "*.sh",
      ".sh_history",
      "sway/config",
      "*.tcshrc",
      ".tmux.conf",
      "tmux.conf",
      "xinitrc",
      ".xinitrc",
      ".xprofile",
      "xserverrc",
      ".xserverrc",
      ".xsession",
      ".xsessionrc",
      ".yash_profile",
      ".yashrc",
      ".zimrc",
      "*.zlogin",
      ".zlogin",
      "*.zlogout",
      ".zlogout",
      "*.zprofile",
      ".zprofile",
      "*.zsh",
      "*.zshenv",
      ".zshenv",
      "*.zshrc",
      ".zshrc",
      "*.zshrc_Apple_Terminal",
      "*.zsh-theme"
    ]
  },
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": true,
      "location": "status_bar",
      "show_commit_summary": true
    }
  },
  "git_panel": {
    "fallback_branch_name": "main"
  },
  "gutter": {
    "folds": true,
    "line_numbers": true,
    "min_line_number_digits": 3,
    "runnables": true
  },
  "helix_mode": true,
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true,
    "show_other_hints": true,
    "show_type_hints": false,
    "show_value_hints": true
  },
  "inline_code_actions": true,
