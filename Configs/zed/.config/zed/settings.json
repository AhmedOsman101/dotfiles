  "cursor_animation": { "enabled": true },
  "cursor_blink": true,
  "cursor_shape": "block",
  "debugger": { "button": false },
  "diagnostics": { "inline": { "enabled": true } },
  "disable_ai": true,
  "ensure_final_newline_on_save": true,
  "file_types": {
    "Shell Script": ["*.inc", "*.sh", "*.bash", "*.zsh"]
  },
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": true,
      "location": "status_bar",
      "show_commit_summary": true
    }
  },
  "git_panel": { "fallback_branch_name": "main" },
  "gutter": {
    "min_line_number_digits": 3,
    "line_numbers": true,
    "runnables": true,
    "folds": true
  },
  "helix_mode": true,
  "icon_theme": "VSCode Icons for Zed (Dark Official Icons)",
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true,
    "show_other_hints": true,
    "show_type_hints": false,
    "show_value_hints": true
  },
  "inline_code_actions": true,
  "languages": {
    "Shell Script": {
      "formatter": {
        "external": { "command": "shellfmt" }
      },
      "document_folding_ranges": "on",
      "code_actions_on_format": {
        "source.fixAll.shellcheck": true
      }
    },
    "C": {
      "formatter": {
        "external": { "command": "astyle" }
      }
    },
    "C++": {
      "formatter": {
        "external": { "command": "astyle" }
      }
    },
    "Java": {
      "formatter": {
        "external": { "command": "astyle" }
      }
    },
    "Fish": {
      "formatter": {
        "external": { "command": "fish_indent" }
      }
    },
    "HTML": {
      "prettier": { "allowed": true },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "CSS": {
      "prettier": { "allowed": false },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "JSON": {
      "prettier": { "allowed": false },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "JSONC": {
      "prettier": { "allowed": false },
      "code_actions_on_format": { "source.fixAll.biome": true },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "JavaScript": {
      "prettier": { "allowed": false },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "TypeScript": {
      "prettier": { "allowed": false },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "TSX": {
      "prettier": { "allowed": false },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": {
        "custom": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      }
    },
    "PHP": {
      "language_servers": [
        "phptools",
        "!phpantom",
        "!intelephense",
        "!phpactor",
        "..."
      ]
    }
  },
  "line_ending": "enforce_lf",
  "lsp": {
    "arduino-language-server": {
      "binary": {
        "path": "/usr/bin/arduino-language-server",
        "arguments": [
          "-clangd",
          "/usr/bin/clangd",
          "-cli",
          "/usr/bin/arduino-cli",
          "-cli-config",
          "/home/othman/.arduino15/arduino-cli.yaml",
          "-fqbn",
          "arduino:avr:uno"
        ]
      }
    },
    "bash-language-server": {
      "settings": {
        "bashIde": {
          "backgroundAnalysisMaxFiles": 500,
          "enableSourceErrorDiagnostics": true,
          "explainshellEndpoint": "",
          "includeAllWorkspaceSymbols": false,
          "shellcheckPath": "/usr/bin/shellcheck",
          "shellcheckExternalSources": true,
          "shfmt": {
            "path": "/usr/bin/shfmt",
            "binaryNextLine": true,
            "caseIndent": false,
            "funcNextLine": false,
            "ignoreEditorconfig": false,
            "languageDialect": "auto",
            "simplifyCode": true,
            "spaceRedirects": false
          }
        }
      }
    },
    "biome": {
      "enable_lsp_tasks": true,
      "settings": {
        "require_config_file": true
      }
    },
    "json-language-server": {
      "initialization_options": {
        "provideFormatter": false
      },
      "settings": {
        "json": {
          "validate": { "enable": true },
          "format": { "enable": false },
          "schemas": [
            {
              "fileMatch": ["deno.json", "deno.jsonc"],
              "url": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json"
            },
            {
              "fileMatch": ["package.json"],
              "url": "https://www.schemastore.org/package"
            },
            {
              "fileMatch": ["tsconfig.json", "tsconfig.*.json"],
              "url": "https://json.schemastore.org/tsconfig.json"
            }
          ]
        },
        "jsonc": {
          "validate": { "enable": true },
          "format": { "enable": false }
        }
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": ["class", "ui", "className"],
        "emmetCompletions": true,
        "experimental": {
          "classRegex": [
            "ui:\\s*{([^)]*)\\s*}",
            "(?:'|\"|`)([^']*)(?:'|\"|`)",
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]"
          ]
        }
      }
    }
  },
  "minimap": {
    "max_width_columns": 250,
    "show": "never"
  },
  "mouse_wheel_zoom": true,
  "node": {
    "npm_path": "pnpm"
  },
  "on_last_window_closed": "quit_app",
  "preferred_line_length": 120,
  "prettier": {
    "allowed": true
  },
  "project_panel": {
    "auto_reveal_entries": false,
    "dock": "left"
  },
  "proxy": "",
  "relative_line_numbers": "enabled",
  "reveal_if_open": true,
  "search": {
    "include_ignored": false
  },
  "semantic_tokens": "combined",
  "session": {
    "trust_all_worktrees": true
  },
  "soft_wrap": "none",
  "status_bar": {
    "show_active_file": true
  },
  "sticky_scroll": {
    "enabled": false
  },
  "tab_size": 2,
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all"
  },
  "terminal": {
    "blinking": "on",
    "copy_on_select": true,
    "font_size": 17.0,
    "line_height": {
      "custom": 1.5
    }
  },
  "theme": "GitHub Dark",
  "title_bar": {
    "show_branch_status_icon": true
  },
  "toolbar": {
    "breadcrumbs": false,
    "code_actions": true
  },
  "ui_font_family": "Inter Variable",
  "ui_font_size": 16.0,
  "use_on_type_format": false,
  "use_smartcase_search": true,
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "vim": {
    "cursor_shape": {
      "insert": "bar"
    },
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "which_key": {
    "enabled": true
  },
  "window_title_format": "${projectName}${separator}${fileName}",
  "window_title_separator": " — "
}
