    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "external": {
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ],
          "command": "biome"
        }
      },
      "language_servers": [
        "typescript-ls",
        "vtsls",
        "!typescript-language-server",
        "!deno",
        "!eslint",
        "!emmet-language-server",
        "..."
      ],
      "prettier": { "allowed": false }
    },
    "Lua": {
      "format_on_save": "on",
      "formatter": "language_server",
      "inlay_hints": {
        "enabled": true,
        "show_other_hints": true,
        "show_parameter_hints": false,
        "show_type_hints": true
      }
    },
    "Markdown": {
      "extend_list_on_newline": true,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "arguments": [
            "--ignore-path=/dev/null",
            "--ignore-unknown=false",
            "--config=/home/othman/.config/.prettierrc.json",
            "--stdin-filepath",
            "{buffer_path}"
          ],
          "command": "prettier"
        }
      },
      "indent_list_on_tab": true,
      "prettier": { "allowed": false },
      "remove_trailing_whitespace_on_save": true
    },
    "PHP": {
      "format_on_save": "on",
      "formatter": {
        "language_server": { "name": "phptools" }
      },
      "language_servers": [
        "phptools",
