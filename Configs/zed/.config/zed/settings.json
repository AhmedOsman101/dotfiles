    "C": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "astyle"
        }
      }
    },
    "C++": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "astyle"
        }
      }
    },
    "CSS": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": [
            "check",
            "--fix",
            "--config-path",
            "/home/othman/.config/biome/biome.json",
            "--stdin-file-path",
            "{buffer_path}"
          ]
        }
      },
      "language_servers": [
        "tailwindcss-intellisense-css",
        "css-variable-lsp",
        "!vscode-css-language-server",
        "..."
      ],
      "prettier": { "allowed": false }
    },
    "Fish": {
      "format_on_save": "on",
      "formatter": {
        "external": { "command": "fish_indent" }
      }
    },
    "HTML": {
      "code_actions_on_format": { "source.fixAll.biome": true },
      "format_on_save": "on",
