// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::SwitchToNormalMode"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "ctrl-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false,
          "comment_empty_lines": false
        }
      ]
    }
  },
  {
    "context": "vim_mode == waiting",
    "unbind": {
      "ctrl-c": "vim::ClearOperators"
    }
  },
  {
    "context": "vim_mode == operator",
    "unbind": {
      "ctrl-c": "vim::ClearOperators"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-c": ["vim::Literal", ["ctrl-c", "\u0003"]]
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-c": "vim::NormalBefore"
    }
  },
  {
    "context": "vim_mode == replace",
    "unbind": {
      "ctrl-c": "vim::NormalBefore"
    }
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "ctrl-c": "vim::SwitchToNormalMode"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-v": ["vim::Literal", ["ctrl-v", "\u0016"]]
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-v": ["vim::PushLiteral", {}]
    }
  },
  {
    "context": "vim_mode == replace",
    "unbind": {
      "ctrl-v": ["vim::PushLiteral", {}]
    }
  },
  {
    "context": "vim_mode == waiting",
    "unbind": {
      "ctrl-v": ["vim::PushLiteral", {}]
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-v": "vim::ToggleVisualBlock"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "unbind": {
      "alt-k": "editor::AcceptNextWordEditPrediction"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "unbind": {
      "alt-j": "editor::AcceptNextLineEditPrediction"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-k": "editor::MoveLineUp"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-j": "editor::MoveLineDown"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-b": ["vim::Literal", ["ctrl-b", "\u0002"]]
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-b": "vim::PageUp"
    }
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      "ctrl-alt-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-j": "vim::Down"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-j": ["vim::Literal", ["ctrl-j", "\n"]]
    }
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      "ctrl-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-s": ["vim::Literal", ["ctrl-s", "\u0013"]]
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-s": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-s": "editor::SaveLocation"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "unbind": {
      "ctrl-s": "editor::SaveLocation"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "escape": [
        "vim::Literal",
        [
          "escape",
          "\u001b"
        ]
      ]
    }
  },
  {
    "context": "BufferSearchBar && !in_replace",
    "unbind": {
      "escape": "buffer_search::Dismiss"
    }
  }
]
