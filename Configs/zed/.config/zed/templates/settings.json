// Zed settings override — Deno variant (template, not live).
//
// Live settings.json uses typescript-ls for JS/TS/JSX/TSX (web work).
// For Deno playground projects (Helix uses deno for the same reason),
// merge this over settings.json or copy the blocks in.
// Mirrors Helix languages.toml (deno live) vs languages.web.toml (typescript-ls template),
// inverted: Zed live = typescript-ls, template = deno.
{
  "lsp": {
    "deno": {
      "settings": {
        "deno": { "enable": true }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!typescript-ls",
        "!eslint",
        "..."
      ]
    },
    "TypeScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!typescript-ls",
        "!eslint",
        "..."
      ]
    },
    "TSX": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!typescript-ls",
        "!eslint",
        "..."
      ]
    }
  }
}
