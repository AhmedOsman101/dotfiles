    "prefix": "tryf",
    "body": [
      "try {",
      "\t${1:// code...}",
      "} catch (${2:e}) {",
      "\t${3:// code...}",
      "}$5 finally {",
      "\t${0:// code...}",
      "}"
    ],
    "description": "Try catch finally block"
