{
  "Array": {
    "prefix": "arr",
    "body": [
      "[ ${1:value}, ${2:value}, $3 ];"
    ],
    "description": "Array []"
  },
  "Array ... value": {
    "prefix": "va",
    "body": [
      "${1:value}, "
    ],
    "description": "Array value statement"
  },
  "If block": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t${0:// code...}",
      "}"
    ],
    "description": "If  block"
  },
  "If single line": {
    "prefix": "sif",
