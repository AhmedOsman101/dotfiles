      "\t${0:// code...}",
      "}"
    ],
    "description": "If else block"
  },
  "If ... else single line": {
    "prefix": "sifel",
    "body": [
      "if (${1:condition}) ${2:code}",
      "else (${3:condition}) ${4:code}"
