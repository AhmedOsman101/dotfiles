{
  "Array": {
    "prefix": "arr",
    "body": [
      "[ ${1:value}, ${2:value}, $3 ];"
    ],
    "description": "Array []"
  },
  "Array ... value": {
    "prefix": "va",
    "body": [
      "${1:value}, "
    ],
    "description": "Array value statement"
  },
  "Object key ... value": {
    "prefix": "obj",
    "body": [
      "{",
      "\t\"${1:key}\": ${2:value},",
      "}"
    ],
    "description": "Object key: value block"
  },
  "Key ... value": {
    "prefix": "kv",
    "body": [
      "\"${1:key}\": ${2:value},"
    ],
    "description": "key => value statement"
  }
}