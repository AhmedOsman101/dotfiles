{
  "desktop": {
    "appOverrides": [],
    "appearance": {
      "activeBorder": "#e0563b",
      "activeOpacity": 1,
      "animations": true,
      "blurEnabled": true,
      "blurNewOptimizations": true,
      "blurPasses": 1,
      "blurPopups": true,
      "blurSize": 1,
      "blurXray": true,
      "borderFollowsPalette": true,
      "borderSize": 0,
      "dimInactive": false,
      "gapsIn": 0,
      "gapsOut": 0,
      "inactiveBorder": "#313a4d",
      "inactiveOpacity": 1,
      "resizeCorner": 0,
      "resizeOnBorder": true,
      "rounding": 8,
      "shadowColor": "#000000",
      "shadowEnabled": true,
      "shadowOffsetX": 0,
      "shadowOffsetY": 5,
      "shadowRange": 45,
      "shadowSpread": 0,
      "wobblyWindows": true
    },
    "apps": {
      "files": "nautilus"
    },
    "autostart": [
      {
        "command": "bash /home/othman/.config/zsh/autostart.sh\n"
      }
    ],
    "cursor": {
      "hideOnKeyPress": true,
      "inactiveTimeout": 0,
      "size": 24,
      "theme": "Bibata-Modern-Ice"
    },
    "env": [
      {
        "key": "EDITOR",
        "value": "/usr/bin/hx"
      }
    ],
    "input": {
      "accelProfile": "",
      "clickfinger": true,
      "disableWhileTyping": true,
      "followMouse": 1,
      "kbLayout": "us,eg",
      "kbOptions": "caps:escape,grp:alt_shift_toggle",
      "kbVariant": "",
      "leftHanded": false,
      "middleClickPaste": true,
      "middleEmulation": false,
      "mouseNaturalScroll": false,
      "mouseScrollFactor": 1,
      "naturalScroll": true,
      "numlockByDefault": false,
      "repeatDelay": 600,
      "repeatRate": 25,
      "sensitivity": 0,
      "tapAndDrag": true,
      "tapToClick": true,
      "touchScrollFactor": 1
    },
    "keybinds": [],
    "windowRules": [],
    "windows": {
      "tameMaximizeOnOpen": false
    }
  },
  "wm": {
    "niri": {
      "alwaysCenterSingleColumn": true,
      "anim": {
        "configNotificationOpenClose": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "horizontalViewMovement": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "overviewOpenClose": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "screenshotUiOpen": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "windowClose": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "windowMovement": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "windowOpen": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "windowResize": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        },
        "workspaceSwitch": {
          "curve": "ease-out-cubic",
          "dampingRatio": 1,
          "durationMs": 250,
          "epsilon": 0.0001,
          "mode": "default",
          "stiffness": 800
        }
      },
      "animationSlowdown": 1,
      "backdropColor": "",
      "backgroundColor": "",
      "blockOutApps": "",
      "borderGradient": false,
      "centerFocusedColumn": "always",
      "defaultColumnDisplay": "normal",
      "defaultColumnWidth": 0.5,
      "disablePowerKey": false,
      "dndEdgeViewScrollDelayMs": 100,
      "dndEdgeViewScrollMaxSpeed": 1500,
      "dndEdgeViewScrollTriggerWidth": 30,
      "dndEdgeWorkspaceDelayMs": 100,
      "dndEdgeWorkspaceMaxSpeed": 1500,
      "dndEdgeWorkspaceTriggerHeight": 50,
      "emptyWorkspaceAboveFirst": false,
      "focusFollowsMouseScroll": 0,
      "frame": "border",
      "gradientAngle": 180,
      "gradientFrom": "#e0563b",
      "gradientRelativeTo": "window",
      "gradientTo": "#9b3226",
      "hotCorners": true,
      "hotkeyOverlayHideNotBound": false,
      "hotkeyOverlaySkip": true,
      "insertHint": true,
      "keysounds": {
        "enabled": false,
        "profile": "cherry-mx-brown",
        "release": true,
        "volume": 0.6
      },
      "layerRules": [],
      "modKey": "Super",
      "modKeyNested": "Super",
      "overviewZoom": 0.5,
      "preferNoCsd": true,
      "presetColumnWidths": "0.25, 0.5, 0.75",
      "presetWindowHeights": "0.33333, 0.5, 0.66667",
      "recentWindows": true,
      "screenshotPath": "~/Pictures/Screenshots/Screenshot_%Y-%m-%d@%I-%M-%S%p.png",
      "settingsWindow": {
        "height": 0.5,
        "mode": "full",
        "width": 0.5
      },
      "struts": {
        "bottom": 0,
        "left": 0,
        "right": 0,
        "top": 0
      },
      "tabIndicatorHideSingle": true,
      "tabIndicatorWidth": 0,
      "urgentColor": "#9b0000",
      "warpMouseToFocus": "off",
      "workspaceAutoBackAndForth": false,
      "workspaceShadow": true,
      "workspaceShadowColor": "",
      "workspaceShadowOffsetY": 10,
      "workspaceShadowSoftness": 40,
      "workspaceShadowSpread": 10
    }
