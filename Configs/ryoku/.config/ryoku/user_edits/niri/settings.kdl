// Generated by Ryoku Settings (Super + ,). Edit in the GUI, not here.

input {
    keyboard {
        xkb {
            layout "us,eg"
            options "caps:escape,grp:alt_shift_toggle"
        }
        repeat-rate 25
        repeat-delay 600
    }
    touchpad {
        tap
        natural-scroll
        dwt
        drag true
        click-method "clickfinger"
    }
    mouse {
    }
    focus-follows-mouse max-scroll-amount="0%"
}

layout {
    gaps 0
    default-column-width { proportion 0.5; }
    center-focused-column "always"
    always-center-single-column
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    border {
        off
        active-color "#c3c5dd"
        inactive-color "#121318"
        urgent-color "#9b0000"
    }
    focus-ring {
        off
    }
    shadow {
        on
        softness 45
        spread 0
        offset x=0 y=5
        color "#000000"
    }
    tab-indicator {
        hide-when-single-tab
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-when-typing
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d@%I-%M-%S%p.png"

overview {
    zoom 0.5
}

environment {
    EDITOR "/usr/bin/hx"
}

spawn-sh-at-startup "bash /home/othman/.config/zsh/autostart.sh"
spawn-sh-at-startup "bash /home/othman/scripts/daily.sh"

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match title="^Welcome to Ryoku$"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 760; }
}

window-rule {
    match title="^Rashin$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 820; }
}

window-rule {
    match title="^ryoku-phone-.*$"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 860; }
}

window-rule {
    match app-id="ryoport_console"
    open-floating true
}

window-rule {
    match app-id="(v|V)ncviewer"
    open-floating true
}

layer-rule {
    match namespace="ryoku-overview-backdrop"
    place-within-backdrop true
}

