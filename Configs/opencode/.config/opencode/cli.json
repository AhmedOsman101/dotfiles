{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "none",
    "permissions": "prompt"
  },
  "animations": true,
  "attention": {
    "notifications": true
  }
}
