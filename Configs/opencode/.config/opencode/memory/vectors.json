  {"id":"environment-001","date":"2026-11-14","file":"topics/environment.md","tags":"cerulean,install,luarocks,lua","fact":"System Lua is 5.5 (/usr/bin/lua, lua5.5). ceru is installed via `sudo make rock` (luarocks dev-1) at /usr/bin/ceru + /usr/share/lua/5.5/cerulean; modules compiled from local dist/. Do NOT use plain `make install` — its default LUADIR=/usr/local/share/lua/5.4 mismatches system Lua 5.5, producing a duplicate/stale wrapper. To reinstall after source changes: make compile && sudo make rock. Uninstall with `sudo luarocks remove cerulean`.","project":"cerulean","vector":[-0.098903,-0.057847,0.071489,0.016979,0.064009,-0.143366,-0.040771,0.04337,-0.019371,-0.025427,0.057158,-0.070977,-0.070647,-0.033954,-0.003579,0.037268,0.060393,-0.028186,-0.051136,-0.011276,0.04967,-0.068208,0.019745,0.072342,-0.015899,0.034864,-0.0015,0.02679,-0.004398,-0.064513,0.127649,0.070341,-0.003724,-0.09385,-0.010209,0.042913,-0.049515,-0.089542,-0.026768,-0.043052,-0.034062,0.034963,0.062629,-0.060818,-0.007589,-0.038761,-0.008297,-0.039257,-0.028438,-0.042797,0.035283,-0.041043,-0.011576,-0.06863,0.003272,0.0012,-0.070433,0.037079,0.091869,0.036512,-0.022135,0.074349,0.010686,-0.029543,-0.032746,-0.017655,0.024276,-0.109793,-0.016966,0.036245,-0.03261,-0.003937,0.054363,0.068014,0.015559,0.058313,0.027528,0.007377,-0.073942,-0.035173,-0.075494,0.003454,0.018125,-0.065511,0.08838,0.059464,0.028734,-0.031458,0.064011,-0.023268,0.068179,-0.007733,-0.042583,0.018768,0.018619,0.025203,0.02327,0.022155,-0.067571,0.040783,-0.029456,-0.060523,0.049887,-0.000243,-0.025632,-0.00834,0.029083,0.0687,-0.099699,0.00052,0.042748,-0.059514,0.044877,-0.059482,-0.040975,0.037985,-0.03151,-0.001778,-0.032876,0.042335,0.035054,0.012514,0.019274,-0.006527,-0.040492,-0.042345,-0.027483,0,0.067245,-0.09873,-0.080022,0.120663,0.050561,-0.003485,0.016735,0.055502,-0.112771,-0.035315,-0.032888,0.038649,-0.036352,-0.07045,0.031965,-0.016476,0.095151,-0.095706,-0.060258,-0.052958,0.004234,-0.046262