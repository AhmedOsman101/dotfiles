{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "websearch": "deny"
  },
  "server": {
    "port": 8081,
    "hostname": "0.0.0.0"
  },
  "mcp": {
    "mgrep": {
      "type": "local",
      "command": ["mgrep", "mcp"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "timeout": 5000,
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "timeout": 5000,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@latest",
        "--executable-path=/usr/bin/thorium-browser-avx2",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "ddg-search": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "duckduckgo-mcp-server[browser]",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "cc-safety-net@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-handoff@latest",
    "envsitter-guard@latest", // prevents agents/tools from reading or editing sensitive .env* files
    "@tarquinen/opencode-smart-title@latest",
    "@dietrichgebert/ponytail@latest"
    // "opencode-system-prompt-logger",
    // "@plannotator/opencode@latest",
    // [
    //   "@knikolov/opencode-plugin-simple-memory@latest",
    //   {
    //     "autoLoad": true,
    //     "autoSave": true,
    //     "autoHookTimeoutMs": 100,
    //     "contextLimit": 10,
    //     "contextMaxChars": 1200,
    //     "contextMinScore": 1,
    //     "autoSaveScope": "user"
    //   }
    // ],
    // "@howaboua/opencode-planning-toolkit@latest" // planning toolkit for OpenCode
  ],
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "hf.co/ewinregirgojr/MiniCPM5-1B-Agentic-Tooluse-GGUF:Q8_0": {
          "name": "MiniCPM 5"
        },
        "qwen3.5:0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "deepseek-r1:1.5b": {
          "name": "DeepSeek R1 1.5B"
        },
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7B"
        },
        "lfm2.5-thinking": {
          "name": "LFM 2.5 Thinking"
        },
        "qwen2.5-coder:0.5b": {
          "name": "Qwen 2.5 Coder 0.5B"
        }
      }
    },
    "llamacpp": {
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:9002/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "minicpm5-1b": {
          "name": "MiniCPM 5"
        },
        "qwen3.5-0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "deepseek-r1-1.5b": {
          "name": "DeepSeek R1 1.5B"
        },
        "qwen3-1.7b": {
          "name": "Qwen 3 1.7B"
        },
        "lfm2.5-thinking": {
          "name": "LFM 2.5 Thinking"
        },
        "qwen2.5-coder-0.5b": {
          "name": "Qwen 2.5 Coder 0.5B"
        }
      }
    },
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:N9ROUTER_API_KEY}"
      },
      "models": {
        "bzl/auto:free": {
          "name": "bzl/auto:free",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "bzl/deepseek-v4-flash": {
          "name": "bzl/deepseek-v4-flash",
          "limit": {
            "context": 1000000,
            "output": 384000
