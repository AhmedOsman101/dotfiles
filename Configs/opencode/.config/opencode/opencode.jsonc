{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "opencode/deepseek-v4-flash-free",
  "server": {
    "port": 8081,
    "hostname": "0.0.0.0"
  },
  "mcp": {
    "mgrep": {
      "type": "local",
      "command": ["mgrep", "mcp"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "timeout": 5000,
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "timeout": 5000,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@latest",
        "--executable-path=/usr/bin/thorium-browser-avx2",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "plugin": [
    "cc-safety-net@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-handoff@latest",
    "envsitter-guard@latest", // prevents agents/tools from reading or editing sensitive .env* files
    "@tarquinen/opencode-smart-title@latest",
    "@dietrichgebert/ponytail@latest"
    // "opencode-system-prompt-logger",
    // "@plannotator/opencode@latest",
    // [
    //   "@knikolov/opencode-plugin-simple-memory@latest",
    //   {
    //     "autoLoad": true,
    //     "autoSave": true,
    //     "autoHookTimeoutMs": 100,
    //     "contextLimit": 10,
    //     "contextMaxChars": 1200,
    //     "contextMinScore": 1,
    //     "autoSaveScope": "user"
    //   }
    // ],
    // "@howaboua/opencode-planning-toolkit@latest" // planning toolkit for OpenCode
  ],
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "hf.co/ewinregirgojr/MiniCPM5-1B-Agentic-Tooluse-GGUF:Q8_0": {
          "name": "MiniCPM 5"
        },
        "qwen3.5:0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "deepseek-r1:1.5b": {
          "name": "DeepSeek R1 1.5B"
        },
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7B"
        },
        "lfm2.5-thinking": {
          "name": "LFM 2.5 Thinking"
        },
        "qwen2.5-coder:0.5b": {
          "name": "Qwen 2.5 Coder 0.5B"
        }
      }
    },
    "llamacpp": {
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:9002/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "minicpm5-1b": {
          "name": "MiniCPM 5"
        },
        "qwen3.5-0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "deepseek-r1-1.5b": {
          "name": "DeepSeek R1 1.5B"
        },
        "qwen3-1.7b": {
          "name": "Qwen 3 1.7B"
        },
        "lfm2.5-thinking": {
          "name": "LFM 2.5 Thinking"
        },
        "qwen2.5-coder-0.5b": {
          "name": "Qwen 2.5 Coder 0.5B"
        }
      }
    },
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:N9ROUTER_API_KEY}"
      },
      "models": {
        "cx/gpt-5.6-luna": { "name": "cx/gpt-5.6-luna" },
        "cx/gpt-5.6-sol": { "name": "cx/gpt-5.6-sol" },
        "cx/gpt-5.6-terra": { "name": "cx/gpt-5.6-terra" },
        "kc/nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "kc/nvidia/nemotron-3-ultra-550b-a55b:free"
        },
        "kc/poolside/laguna-s-2.1:free": {
          "name": "kc/poolside/laguna-s-2.1:free"
        },
        "kc/tencent/hy3:free": { "name": "kc/tencent/hy3:free" },
        "kc/stepfun/step-3.7-flash:free": {
          "name": "kc/stepfun/step-3.7-flash:free"
        },
        "kc/nvidia/nemotron-3.5-lightning:free": {
          "name": "kc/nvidia/nemotron-3.5-lightning:free"
        },
        "kr/claude-opus-4.8": { "name": "kr/claude-opus-4.8" },
        "kr/claude-opus-5": { "name": "kr/claude-opus-5" },
        "kr/claude-sonnet-5": { "name": "kr/claude-sonnet-5" },
        "kr/glm-5": { "name": "kr/glm-5" },
        "kr/gpt-5.6-luna": { "name": "kr/gpt-5.6-luna" },
        "kr/gpt-5.6-sol": { "name": "kr/gpt-5.6-sol" },
        "kr/gpt-5.6-terra": { "name": "kr/gpt-5.6-terra" },
        "mmf/mimo-auto": { "name": "mmf/mimo-auto" },
        "oc/big-pickle": { "name": "oc/big-pickle" },
        "oc/deepseek-v4-flash-free": { "name": "oc/deepseek-v4-flash-free" },
        "oc/laguna-s-2.1-free": { "name": "oc/laguna-s-2.1-free" },
        "oc/ling-3.0-flash-free": { "name": "oc/ling-3.0-flash-free" },
        "oc/longcat-2.0-free": { "name": "oc/longcat-2.0-free" },
        "oc/mimo-v2.5-free": { "name": "oc/mimo-v2.5-free" },
        "oc/nemotron-3-ultra-free": { "name": "oc/nemotron-3-ultra-free" },
        "kimchi/minimax-m3": { "name": "kimchi/minimax-m3" },
        "kimchi/kimi-k2.7": { "name": "kimchi/kimi-k2.7" },
        "kimchi/nemotron-3-ultra-fp4": {
          "name": "kimchi/nemotron-3-ultra-fp4"
        },
        "kimchi/deepseek-v4-flash": { "name": "kimchi/deepseek-v4-flash" },
        "kimchi/glm-5.2-fp8": { "name": "kimchi/glm-5.2-fp8" },
        "nvidia/deepseek-ai/deepseek-v4-flash": {
          "name": "nvidia/deepseek-ai/deepseek-v4-flash"
        },
        "nvidia/z-ai/glm-5.2": { "name": "nvidia/z-ai/glm-5.2" },
        "nvidia/minimaxai/minimax-m3": {
          "name": "nvidia/minimaxai/minimax-m3"
        },
        "nvidia/nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "nvidia/nvidia/nemotron-3-ultra-550b-a55b"
        },
        "ollama/glm-4.7-flash": { "name": "ollama/glm-4.7-flash" },
        "ollama/glm-5": { "name": "ollama/glm-5" },
        "ollama/minimax-m3": { "name": "ollama/minimax-m3" },
        "ollama/qwen3.5": { "name": "ollama/qwen3.5" },
        "openrouter/openrouter/free": { "name": "openrouter/openrouter/free" },
        "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
        },
        "openrouter/nvidia/nemotron-3.5-lightning:free": {
          "name": "openrouter/nvidia/nemotron-3.5-lightning:free"
        },
        "bzl/auto:free": { "name": "bzl/auto:free" },
        "bzl/deepseek-v4-flash": { "name": "bzl/deepseek-v4-flash" },
        "bzl/qwen3.7-flash": { "name": "bzl/qwen3.7-flash" },
        "ollama-local/deepseek-r1:1.5b": {
          "name": "ollama-local/deepseek-r1:1.5b"
        },
        "ollama-local/hf.co/ewinregirgojr/MiniCPM5-1B-Agentic-Tooluse-GGUF:Q8_0": {
          "name": "ollama-local/MiniCPM5-1B"
        },
        "ollama-local/qwen2.5-coder:0.5b": {
          "name": "ollama-local/qwen2.5-coder:0.5b"
        },
        "ollama-local/qwen3.5:0.8b": { "name": "ollama-local/qwen3.5:0.8b" },
        "ollama-local/lfm2.5-thinking": {
          "name": "ollama-local/lfm2.5-thinking"
        },
        "ollama-local/qwen3:1.7b": { "name": "ollama-local/qwen3:1.7b" }
      }
    }
  }
}
