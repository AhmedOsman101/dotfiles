{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "typescript": {
      "command": ["tsc", "--lsp", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"],
      "initialization": {
        "check": { "command": "clippy" },
        "checkOnSave": true
      }
    },
    "php": {
      "command": ["devsense-php-ls", "-vscode"],
      "extensions": [".php"],
      "initialization": {
        "php.completion.autoimport": "auto-import-grouped",
        "php.completion.autoimport-docblock": "auto-import-grouped",
        "php.completion.parameters": "parameters",
        "php.completion.showParameters": true,
        "php.docblock.colorMode": "simple",
        "php.format.codeStyle": "K&R",
        "php.format.rules.addCommaAfterLastArrayElement": true,
        "php.format.rules.addCommaAfterLastCallParameter": false,
        "php.format.rules.addCommaAfterLastDeclParameter": true,
        "php.format.rules.alignConsecutiveAssignments": false,
        "php.format.rules.alignConstants": true,
        "php.format.rules.alignEnumCases": true,
        "php.format.rules.alignMatchArmBodies": true,
        "php.format.rules.arrayInitializersAlignKeyValuePairs": true,
        "php.format.rules.arrayInitializersNewLineAfterLastElement": true,
        "php.format.rules.arrayInitializersNewLineBeforeFirstElement": true,
        "php.format.rules.arrayInitializersWrap": "onEveryItem",
        "php.format.rules.blankLinesAfterClass": 1,
        "php.format.rules.booleanConstantCasing": "lowercase",
        "php.format.rules.callParametersNewLineAfterLeftParen": true,
        "php.format.rules.callParametersNewLineBeforeRightParen": true,
        "php.format.rules.callParametersWrap": "onEveryItem",
        "php.format.rules.catchOnNewLine": false,
        "php.format.rules.declParametersNewLineAfterLeftParen": true,
        "php.format.rules.declParametersNewLineBeforeRightParen": true,
        "php.format.rules.elseOnNewLine": false,
        "php.format.rules.endWithNewLine": true,
        "php.format.rules.finallyOnNewLine": false,
        "php.format.rules.forStatementNewLineAfterLeftParen": true,
        "php.format.rules.groupUseNewLineBeforeFirstDeclaration": true,
        "php.format.rules.ifStatementNewLineAfterLeftParen": true,
        "php.format.rules.ifStatementNewLineBeforeRightParen": true,
        "php.format.rules.importSorting": "alphabetic",
        "php.format.rules.indentBraces": false,
        "php.format.rules.keepControlStatementsOnOneLine": true,
        "php.format.rules.keepFunctionsOnOneLine": true,
        "php.format.rules.newLineAfterImplements": true,
        "php.format.rules.nullConstantCasing": "lowercase",
        "php.format.rules.openBraceOnNewLineForAnonymousClasses": true,
        "php.format.rules.openBraceOnNewLineForBlocks": false,
        "php.format.rules.openBraceOnNewLineForFunctions": false,
        "php.format.rules.openBraceOnNewLineForLambdas": false,
        "php.format.rules.openBraceOnNewLineForNamespaces": false,
        "php.format.rules.openBraceOnNewLineForTypes": false,
        "php.format.rules.spaceAfterCast": true,
        "php.format.rules.spaceAroundConcatenation": true,
        "php.format.rules.spaceBeforeColonInControlStatements": false,
        "php.format.rules.spaceBeforeParenthesesInControlStatements": true,
        "php.format.rules.spaceWithinArrayInitilizersParens": false,
        "php.format.rules.switchStatementNewLineAfterLeftParen": true,
        "php.format.rules.switchStatementNewLineBeforeRightParen": true,
        "php.format.rules.whileStatementNewLineAfterLeftParen": true,
        "php.format.rules.whileStatementNewLineBeforeRightParen": true,
        "php.hover.fullname": true,
        "php.hover.parametersFullName": true,
        "php.inlayHints.insertOnDoubleClick": true,
        "php.inlayHints.parameters.enabled": false,
        "php.inlayHints.parameters.suppressNameMatchingValue": true,
        "php.inlayHints.types.return": "named",
        "php.problems.excludeGitIgnore": true,
        "php.problems.scope": "all",
        "php.sortUses.caseSensitive": false
      }
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"],
      "initialization": {
        "Lua": {
          "hint": {
            "enable": true,
            "arrayIndex": "Enable",
            "setType": true,
            "paramName": "All",
            "paramType": true,
            "await": true
          }
        }
      }
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh"],
      "initialization": {
        "bashIde": {
          "backgroundAnalysisMaxFiles": 500,
          "enableSourceErrorDiagnostics": true,
          "explainshellEndpoint": "",
          "includeAllWorkspaceSymbols": false,
          "shellcheckExternalSources": true,
          "shellcheckPath": "/usr/bin/shellcheck",
          "shfmt": {
            "binaryNextLine": true,
            "caseIndent": false,
            "funcNextLine": false,
            "ignoreEditorconfig": false,
            "languageDialect": "auto",
            "path": "/usr/bin/shfmt",
            "simplifyCode": true,
            "spaceRedirects": false
          }
        }
      }
    },
    "c": {
      "command": ["clangd"],
      "extensions": [".c", ".h"]
    },
    "cpp": {
      "command": ["clangd"],
      "extensions": [".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"]
    },
    "python": {
      "command": ["ruff", "server"],
      "extensions": [".py"]
    },
    "toml": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    },
    "toml-tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    },
    "sql": {
      "command": ["syntaqlite", "lsp"],
      "extensions": [".sql"]
    },
    "markdown": {
      "command": ["markdown-oxide"],
      "extensions": [".md", ".markdown"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"],
      "initialization": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true
        }
      }
    },
    "java": {
      "command": ["jdtls"],
      "extensions": [".java"]
    },
    "kotlin": {
      "command": ["kotlin-lsp", "--stdio"],
      "extensions": [".kt", ".kts"]
    },
    "html": {
      "command": ["vscode-html-language-server", "--stdio"],
      "extensions": [".html"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json"]
    },
    "vim": {
      "command": ["vim-language-server", "--stdio"],
      "extensions": [".vim"]
    },
    "emmet": {
      "command": ["emmet-language-server", "--stdio"],
      "extensions": [".html"]
    },
    "vue": {
      "command": ["vue-language-server", "--stdio"],
      "extensions": [".vue"]
    }
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 8081,
    "password": "123",
    "cors": ["https://opencode.dev"]
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": "allow"
  },
  "mcp": {
    "mgrep": {
      "type": "local",
      "command": ["mgrep", "mcp"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "timeout": 5000,
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "timeout": 5000,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp@latest",
        "--executable-path=/usr/bin/thorium-browser-avx2",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "ddg-search": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "duckduckgo-mcp-server[browser]",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "bun-docs": {
      "type": "remote",
      "url": "https://bun.com/docs/mcp",
      "enabled": false
    }
  },
  "plugin": [
    "cc-safety-net@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-handoff@latest",
    // "envsitter-guard@latest", // prevents agents/tools from reading or editing sensitive .env* files
    // "@tarquinen/opencode-smart-title@latest", // TODO: restore after PR #13 merges
    // "@tarquinen/opencode-smart-title@git+https://github.com/AhmedOsman101/opencode-smart-title.git#run/fork-build", // replaced by local clone in plugins/opencode-smart-title/ (auto-loaded, avoids DEP0169)
    "@dietrichgebert/ponytail@latest"
    // "opencode-system-prompt-logger",
    // "@plannotator/opencode@latest",
    // [
    //   "@knikolov/opencode-plugin-simple-memory@latest",
    //   {
    //     "autoLoad": true,
    //     "autoSave": true,
    //     "autoHookTimeoutMs": 100,
    //     "contextLimit": 10,
    //     "contextMaxChars": 1200,
    //     "contextMinScore": 1,
    //     "autoSaveScope": "user"
    //   }
    // ],
    // "@howaboua/opencode-planning-toolkit@latest" // planning toolkit for OpenCode
  ],
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "hf.co/ewinregirgojr/MiniCPM5-1B-Agentic-Tooluse-GGUF:Q8_0": {
          "name": "MiniCPM 5"
        },
        "qwen3.5:0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "deepseek-r1:1.5b": {
          "name": "DeepSeek R1 1.5B"
        },
        "qwen3:1.7b": {
          "name": "Qwen 3 1.7B"
        },
        "lfm2.5-thinking": {
          "name": "LFM 2.5 Thinking"
        },
        "qwen2.5-coder:0.5b": {
          "name": "Qwen 2.5 Coder 0.5B"
        }
      }
    },
    "llamacpp": {
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:9002/v1",
        "apiKey": "llamacpp"
      },
      "models": {
        "minicpm5-1b": {
          "name": "MiniCPM 5"
        },
        "qwen3.5-0.8b": {
          "name": "Qwen 3.5 0.8B"
        },
        "deepseek-r1-1.5b": {
          "name": "DeepSeek R1 1.5B"
        },
        "qwen3-1.7b": {
          "name": "Qwen 3 1.7B"
        },
        "lfm2.5-thinking": {
          "name": "LFM 2.5 Thinking"
        },
        "qwen2.5-coder-0.5b": {
          "name": "Qwen 2.5 Coder 0.5B"
        }
      }
    },
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "kc/reflection/beam-free": {
          "name": "kc/reflection/beam-free",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 131072,
            "input": 1048576
          }
        },
        "auto/best-free": {
          "name": "auto/best-free",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true
        },
        "auto/coding:free": {
          "name": "auto/coding:free",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true
        },
        "kc/kilo-auto/free": {
          "name": "Kilo Auto Free",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "kc/poolside/laguna-s-2.1:free": {
          "name": "kc/poolside/laguna-s-2.1:free",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "kc/nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "kc/nvidia/nemotron-3-ultra-550b-a55b:free",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
