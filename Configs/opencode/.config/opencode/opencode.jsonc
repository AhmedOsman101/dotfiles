        },
        "oc/big-pickle": {
          "name": "oc/big-pickle"
        },
        "oc/deepseek-v4-flash-free": {
          "name": "oc/deepseek-v4-flash-free"
        },
        "oc/mimo-v2.5-free": {
          "name": "oc/mimo-v2.5-free"
        },
        "nvidia/z-ai/glm-5.2": {
          "name": "nvidia/z-ai/glm-5.2"
        },
        "nvidia/moonshotai/kimi-k2.6": {
          "name": "nvidia/moonshotai/kimi-k2.6"
        },
        "nvidia/deepseek-ai/deepseek-v4-pro": {
          "name": "nvidia/deepseek-ai/deepseek-v4-pro"
        },
        "nvidia/minimaxai/minimax-m3": {
          "name": "nvidia/minimaxai/minimax-m3"
        },
        "nvidia/minimaxai/minimax-m2.7": {
          "name": "nvidia/minimaxai/minimax-m2.7"
        },
        "ollama/minimax-m3": {
          "name": "ollama/minimax-m3"
        },
        "ollama/glm-5": {
