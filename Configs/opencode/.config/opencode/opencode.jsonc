        },
        "cx/gpt-5.6-terra": {
          "name": "cx/gpt-5.6-terra"
        },
        "cx/gpt-5.6-sol": {
          "name": "cx/gpt-5.6-sol"
        },
        "cx/gpt-5.6-luna": {
          "name": "cx/gpt-5.6-luna"
        },
        "cx/gpt-5.5": {
