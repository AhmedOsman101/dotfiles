{
  "$schema": "https://raw.githubusercontent.com/AhmedOsman101/commit-sage-cli/refs/heads/main/config.schema.json",
  "model": "gemini/gemini-3.1-flash-lite",
  "generation": {
    "maxRetries": 3,
    "retryDelay": 1000,
    "temperature": 0.3,
    "maxPromptTokens": 100000,
    "diffStrategy": "staged"
  },
  "providers": {
    "defaults": {
      "timeoutMs": 60000,
      "reasoning": "off",
      "apiType": "openai-chat"
    },
    "openai": {
      "baseUrl": "http://localhost:8082/v1",
      "apiKey": "$OMNIROUTE_API_KEY",
      "apiType": "openai-chat"
    }
  },
  "commit": {
    "autoCommit": false,
    "autoPush": false,
    "onlyStagedChanges": true,
    "commitFormat": "conventional",
    "commitLanguage": "english",
    "promptForRefs": false,
    "maxLength": 80,
    "bodyStyle": "subject-body"
  }
}