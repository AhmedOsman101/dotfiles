{
  "$schema": "https://raw.githubusercontent.com/AhmedOsman101/commit-sage-cli/refs/heads/main/config.schema.json",
  "model": "omniroute/agnes/agnes-3.0-flash",
  "generation": {
    "maxRetries": 3,
    "retryDelay": 1000,
    "temperature": 0.3,
    "maxPromptTokens": 100000,
    "maxOutputTokens": 4096,
    "diffStrategy": "staged"
  },
  "providers": {
    "defaults": {
      "timeoutMs": 60000,
      "reasoning": "off",
      "apiType": "openai-chat"
    },
    "omniroute": {
      "baseUrl": "http://localhost:8082/v1",
      "apiKey": "$OMNIROUTE_API_KEY",
      "apiType": "openai-chat",
      "models": {
        "agnes/agnes-3.0-flash": {
          "reasoning": "max",
          "contextWindow": 512000,
          "maxOutputTokens": 65536,
          "maxInputTokens": 512000
        },
        "auto/best-free": {
          "reasoning": "high",
          "contextWindow": 2000000,
          "maxInputTokens": 2000000,
          "maxOutputTokens": 524288
        },
        "kc/kilo-auto/free": {
          "contextWindow": 256000,
          "maxInputTokens": 256000,
          "maxOutputTokens": 32768
        }
      }
    }
  },
  "commit": {
    "autoCommit": false,
    "autoPush": false,
    "onlyStagedChanges": true,
    "commitFormat": "conventional",
    "commitLanguage": "english",
    "promptForRefs": false,
    "customInstructions": "",
    "refs": {
      "enabled": false,
      "source": "prompt",
      "value": "",
      "placement": "end",
      "branchPattern": "[A-Z][A-Z0-9]*-[0-9]+"
    },
    "maxLength": 80,
    "bodyStyle": "subject-body",
    "recentCommits": {
      "enabled": false,
      "count": 5,
      "scope": "all"
    }
  },
  "git": {
    "timeoutMs": 30000
  }
}
